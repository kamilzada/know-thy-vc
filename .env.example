# Gemini (Google AI Studio). Only Gemini Flash is used.
GEMINI_API_KEY=
# Optional: override the model. Defaults to gemini-flash-latest (always the newest Flash).
GEMINI_MODEL=

# Tavily search (https://app.tavily.com)
TAVILY_API_KEY=

# Supabase (optional: without it, briefs aren't cached or saved to history)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: route Gemini Flash through OpenRouter (used instead of GEMINI_API_KEY when set)
OPENROUTER_API_KEY=
# Optional: comma-separated Flash fallback order on OpenRouter
OPENROUTER_MODELS=
